{
  "name": "propvexis-backend",
  "version": "0.1.0",
  "description": "Trade tracker backend: ingest MT5 trades, store in Postgres, broadcast over WebSocket",
  "type": "module",
  "main": "src/server.js",
  "//engines": "google-auth-library@11 requires >=22, and npm's engines check is advisory by default — it warns and installs anyway. Stated here so the requirement is visible at the top of the tree rather than buried in a transitive dependency, and so CI, the Dockerfile and the box have one declared source of truth to match.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "node --test test/*.test.js",
    "db:pull": "node scripts/db-pull.js",
    "db:setup": "node scripts/setup-db.js",
    "db:migrate": "node scripts/migrate.js",
    "db:backup": "bash scripts/backup-db.sh",
    "db:seed-accounts": "node scripts/seed-accounts.js",
    "db:backfill-ownership": "node scripts/backfill-trade-ownership.js",
    "db:recompute-fixed-r": "node scripts/recompute-fixed-r.js",
    "smoke": "node scripts/smoke-ingest.js",
    "test:ea": "node scripts/test-ea-payload.js",
    "import:sheet": "node scripts/import-sheet.js"
  },
  "dependencies": {
    "@aws-sdk/client-ssm": "^3.1104.0",
    "@fastify/cookie": "^11.1.2",
    "@fastify/cors": "^10.0.1",
    "@fastify/jwt": "^10.2.1",
    "@fastify/rate-limit": "^11.2.0",
    "@sentry/node": "^10.69.0",
    "@socket.io/redis-adapter": "^8.3.0",
    "dotenv": "^16.4.7",
    "fastify": "^5.11.2",
    "google-auth-library": "^11.0.0",
    "pg": "^8.13.1",
    "prom-client": "^15.1.3",
    "redis": "^6.2.0",
    "socket.io": "^4.8.1"
  },
  "devDependencies": {
    "socket.io-client": "^4.8.1"
  },
  "registries": {
    "@coss": "https://coss.com/ui/r/{name}.json"
  }
}
