# Backend base URL (REST + WebSocket). Leave EMPTY in dev to use the Vite
# proxy so the session cookie stays same-origin. Set to the same-origin
# deployment URL in production.
VITE_BACKEND_URL=

# Google OAuth Web client ID (public; same value as backend GOOGLE_CLIENT_ID)
VITE_GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com

# Sentry DSN for frontend error tracking (public; safe in the client bundle).
# Leave empty to disable Sentry. In prod it's injected by the deploy workflow.
VITE_SENTRY_DSN=
