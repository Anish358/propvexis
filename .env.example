# Backend config — copy to .env and adjust
PORT=3000
HOST=0.0.0.0

# Postgres connection
DATABASE_URL=postgres://localhost:5432/amey_journal

# Shared secret the MT5 EA must send in the X-Ingest-Token header
INGEST_TOKEN=change-me-to-a-long-random-string

# Comma-separated list of allowed CORS origins for the frontend (use * for dev only)
CORS_ORIGIN=*
