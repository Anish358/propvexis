# Backend config — copy to .env and adjust
PORT=3000
HOST=0.0.0.0

# Postgres connection
DATABASE_URL=postgres://localhost:5432/amey_journal

# ---- Postgres connection pool ----
# All optional; the defaults below are what src/db.js applies. Sizing is PER
# PROCESS: under pm2 cluster mode the box holds (workers x PG_POOL_MAX)
# connections, and prod/staging/dev share ONE Postgres instance
# (max_connections=100, 3 superuser-reserved). Check headroom before raising:
#   psql -c "show max_connections"
#   psql -c "select application_name, count(*) from pg_stat_activity group by 1"
# PG_POOL_MAX=20
# PG_POOL_IDLE_TIMEOUT_MS=30000
# How long a request waits for a free client before erroring. Never set 0 —
# node-pg reads that as "wait forever", which hangs handlers under load.
# PG_POOL_CONNECTION_TIMEOUT_MS=5000
# PG_POOL_MAX_USES=7500

# Shared secret the MT5 EA must send in the X-Ingest-Token header
INGEST_TOKEN=change-me-to-a-long-random-string

# Comma-separated list of allowed CORS origins for the frontend (use * for dev only)
CORS_ORIGIN=*

# ---- Auth ----
# OAuth 2.0 Web client ID from Google Cloud Console (Credentials page)
GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
# Long random string used to sign the session JWT (e.g. `openssl rand -hex 32`)
SESSION_SECRET=change-me-to-a-long-random-string
# Comma-separated allowlist of emails permitted to log in (empty = nobody)
ALLOWED_EMAILS=you@gmail.com,friend@gmail.com
# Session length in days (default 30) and whether cookies require HTTPS
SESSION_MAX_DAYS=30
# COOKIE_SECURE defaults to true in production, false otherwise; override if needed
# COOKIE_SECURE=false

# ---- Redis (optional: shared socket adapter + cache invalidation) ----
# Unset = disabled, and the app runs exactly as it does single-process: in-memory
# Socket.IO adapter, process-local analytics cache. REQUIRED before raising
# WORKERS above 1 in ecosystem.config.cjs, or clustered workers drop realtime
# events and serve stale analytics (src/cluster.js warns at boot either way).
# Accepts redis:// and rediss:// (TLS), so the same var works for a native
# redis-server on the box, Upstash, or ElastiCache.
# A failed connect is NOT fatal: the app logs and runs degraded rather than
# refusing to boot, so a Redis outage can't take the API down.
# REDIS_URL=redis://127.0.0.1:6379

# ---- Observability ----
# Optional bearer token guarding GET /metrics (Prometheus scrape endpoint).
# Empty = unguarded; safe in prod since the backend binds loopback and Caddy
# does not proxy /metrics. Set it for defense-in-depth (Prometheus then scrapes
# with an Authorization: Bearer header).
# METRICS_TOKEN=change-me-to-a-long-random-string
