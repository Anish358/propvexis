# Copy to terraform.tfvars (gitignored) and fill in real values.
region                = "ap-south-1"
domain                = "journal.example.com"
admin_cidr            = "203.0.113.10/32"          # your admin IP /32
ssh_key_name          = "your-ec2-key-pair-name"
instance_type         = "t3.small"
root_volume_gb        = 20
backup_bucket_name    = "your-globally-unique-backup-bucket"
backup_retention_days = 90
alert_email           = "alerts@example.com"
